# Copy this file to .env and fill in values. If LLM_API_KEY is left empty
# the app runs in demo mode: BM25 search instead of embeddings, and the
# draft step returns the top template with placeholders instead of a
# real LLM-written draft. No config is required to run the app.

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
